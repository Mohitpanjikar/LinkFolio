# Supabase Configuration
SUPABASE_URL=your_supabase_url_here
SUPABASE_KEY=your_supabase_anon_key_here

# Server Configuration
PORT=8080
NODE_ENV=production

# CORS Configuration (comma-separated URLs for multiple origins)
CORS_ORIGIN=https://yourdomain.com,https://linkfolio.netlify.app

# Optional: JWT Secret (if you decide to implement proper JWT authentication)
JWT_SECRET=your_jwt_secret_here
